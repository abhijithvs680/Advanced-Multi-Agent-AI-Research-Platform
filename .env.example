# Multi-Agent AI Research Platform Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# LLM Provider Configuration (Required)
# ===========================================
# Choose provider: openai or anthropic
LLM_PROVIDER=openai

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# External Services Configuration
# ===========================================
# Semantic Scholar API Key (optional, for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# ===========================================
# Authentication & Security
# ===========================================
# Secret key for JWT token generation (change this in production!)
SECRET_KEY=change_me_to_a_secure_random_string
JWT_EXPIRY_HOURS=24

# Default Admin User
ADMIN_EMAIL=admin@research.local
ADMIN_PASSWORD=admin123

# ===========================================
# Application Configuration
# ===========================================
# Number of workflow workers (defaults to CPU count or 2)
# Set to 1 for easier debugging
NUM_WORKERS=2

# Development Mode (true enables auto-reload)
RELOAD_ENABLED=true

# API Server settings
API_HOST=0.0.0.0
API_PORT=8000
# Config file path
CONFIG_PATH=/app/config/config.yaml

# ===========================================
# Infrastructure Configuration
# (These are auto-configured by Docker, usually no need to change)
# ===========================================
# Database Connection
# DATABASE_URL=postgresql://research:research@postgres:5432/research_db

# Redis Connection
# REDIS_URL=redis://redis:6379/0

# MLflow Tracking Server
# MLFLOW_TRACKING_URI=http://mlflow:5000
